# PHANTOM Backend Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=phantom
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Security
MAX_REDIRECTS=5
REQUEST_TIMEOUT_SECONDS=10
MAX_RESPONSE_SIZE_BYTES=10485760

# External APIs (optional — modules degrade gracefully without these)
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
